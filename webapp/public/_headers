# Cloudflare Pages response headers (copied into dist/ by the build; the Vite
# dev server ignores this file).
#
# The session token lives in localStorage, so a script injection would be an
# account takeover: the CSP allows only this site's own bundle, and network
# calls only to Supabase. frame-ancestors / X-Frame-Options stop another site
# from framing the admin pages (clickjacking).
#
# Adding a third-party script, font or image host? It must be listed here or
# the browser blocks it. To pin Supabase to this project, replace
# *.supabase.co with <project-ref>.supabase.co.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

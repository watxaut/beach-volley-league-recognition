{
  // Cloudflare Workers static-assets deploy. SPA fallback (deep links like
  // /matches/... serve index.html) is done here, because Workers rejects a
  // `/* /index.html 200` rule in public/_redirects as an infinite loop.
  // Response headers still come from public/_headers.
  "name": "beach-volley-league-recognition",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}

# Copy to .env.local for `npm run dev` against your Supabase project, or set the
# same two variables as build variables in Cloudflare Workers (Settings -> Variables and secrets -> Build).
# The publishable (anon) key is PUBLIC by design: every table is protected by RLS.
# NEVER put the secret/service-role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_DEMO=1   # synthetic in-memory data, no Supabase needed

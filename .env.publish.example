# Copy to .env.publish (git-ignored) in the PROD worktree and `chmod 600` it.
# Used by `make publish`, `make inbox` and `make backup` on the processing laptop.

# Supabase -> Project Settings -> API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
# The SECRET key (sb_secret_...) or the legacy service_role key. It bypasses all
# access rules: keep it on this laptop only -- never in webapp/, never in git.
SUPABASE_SECRET_KEY=sb_secret_...

# Google Drive via rclone (`rclone config`, remote name below)
VOLLEY_RCLONE_REMOTE=gdrive
VOLLEY_DRIVE_INBOX=VolleyInbox
VOLLEY_DRIVE_ARCHIVE=VolleyArchive
VOLLEY_DRIVE_BACKUPS=VolleyBackups

# Local time zone of the recordings (names files YYYYMMDD_HHMM_...)
VOLLEY_TZ=Europe/Madrid
# 1 = only start a pipeline run on AC power
VOLLEY_REQUIRE_AC=1
# Court calibration without clicks (AGENTS.md §14, docs/auto_calibration.md):
#   propose = leave a proposal, wait for `make calibrate` (A = accept it)
#   accept  = run on a calibration the detector accepted by itself
#   off     = always wait for the 8 clicks
VOLLEY_AUTO_CALIBRATION=propose
